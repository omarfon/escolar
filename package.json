{
  "name": "escolar",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "qa:install": "playwright install chromium",
    "qa:visual": "playwright test --project=visual",
    "qa:visual:update": "playwright test --project=visual --update-snapshots",
    "qa:visual:ui": "playwright test --project=visual --ui",
    "qa:visual:report": "playwright show-report",
    "qa:e2e": "playwright test --project=e2e",
    "qa:e2e:headed": "playwright test --project=e2e --headed --workers=1",
    "qa:e2e:headed:flows": "playwright test --project=e2e --headed --workers=1 e2e/flows/",
    "qa:e2e:flows": "playwright test --project=e2e e2e/flows/",
    "qa:e2e:ui": "playwright test --project=e2e --ui",
    "qa": "playwright test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.7.0",
  "dependencies": {
    "@angular/animations": "^21.2.17",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@ngrx/signals": "^21.1.1",
    "chart.js": "^4.5.1",
    "date-fns": "^4.4.0",
    "jwt-decode": "^4.0.0",
    "ng2-charts": "^10.0.0",
    "ngx-toastr": "^20.0.5",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@angular/build": "^21.0.3",
    "@angular/cli": "^21.0.3",
    "@angular/compiler-cli": "^21.0.0",
    "@playwright/test": "^1.62.0",
    "autoprefixer": "^10.5.0",
    "jsdom": "^27.1.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
